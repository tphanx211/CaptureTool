<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Width="320" Height="530">
        <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Classes="nav-button" Background="Transparent" Margin="0 0 -5 0">
                <Label Classes="icon" 
                       Content="&#xE4C2;"
                       FontFamily="{DynamicResource PhosphorFill}" FontSize="20"/>
            </Button>
            <Menu>
                <MenuItem IsSubMenuOpen="True">
                    <MenuItem.Header>
                        <TextBlock Classes="menu" Text="&#xE270;" FontSize="20"/>
                    </MenuItem.Header>
                    <MenuItem>
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox />
                                <TextBlock Text="Launch at Startup"/>
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                </MenuItem>
            </Menu>
        </StackPanel>
            
    
        <Border Grid.Row="1" Margin="10 20 10 10" CornerRadius="8" Background="Black">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                <Image Source="/Assets/CaptureToolLogo.png"
                       Width="70" Height="70"
                       HorizontalAlignment="Center" />
                
                <TextBlock Text="Tony’s Demo"
                           FontFamily="{DynamicResource InterBold}"
                           FontSize="16"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />

                <Button Classes="secondary" Width="270">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <Label Classes="icon" Content="&#xE326;" FontFamily="{DynamicResource Phosphor}" Margin="0 3  0 0"/>
                        <TextBlock Text="Voice transcription" FontFamily="{DynamicResource InterBold}" Margin="0 4  0 0"/>
                        <ToggleSwitch IsChecked="True" Margin="0 -5  0 0"/>
                    </StackPanel>
                </Button>

                <Button Classes="primary" >
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="2">
                        <Label Classes="icon" Content="&#xE3EE;" FontFamily="{DynamicResource PhosphorFill}" />
                        <TextBlock Text="Start Capture" FontFamily="{DynamicResource InterBold}" Margin="0 2  0 0"/>
                    </StackPanel>
                </Button>

                <Button Classes="secondary" Content="Sign Out" FontFamily="{DynamicResource InterBold}"/>
            </StackPanel>
            
            
        </Border>
    </Grid>
        </Border>
    </Design.PreviewWith>

    <Style Selector="CheckBox">
        <Setter Property="Margin" Value="0 1 0 -20"/>
        <Setter Property="Template">
          <ControlTemplate>
            <Grid x:Name="RootGrid" ColumnDefinitions="20,*">
              <Border x:Name="PART_Border"
                      Grid.ColumnSpan="2"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}" />

              <Grid Grid.Column="0" VerticalAlignment="Top" Height="12">
                <Border x:Name="NormalRectangle"
                        BorderBrush="{DynamicResource CheckBoxCheckBackgroundStrokeUnchecked}"
                        Background="{DynamicResource CheckBoxCheckBackgroundFillUnchecked}"
                        BorderThickness="{DynamicResource CheckBoxBorderThemeThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        UseLayoutRounding="False"
                        Height="12"
                        Width="12" />

                <Viewbox UseLayoutRounding="False">
                  <Panel>
                    <Panel Height="12" Width="12" />
                    <Path x:Name="CheckGlyph"
                          Margin="2 0 0 0"
                          Opacity="0"
                          Height="5" Width="5"
                          Fill="{DynamicResource CheckBoxCheckGlyphForegroundUnchecked}"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                  </Panel>
                </Viewbox>
              </Grid>
              <ContentPresenter x:Name="PART_ContentPresenter"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Content="{TemplateBinding Content}"
                              Margin="{TemplateBinding Padding}"
                              RecognizesAccessKey="True"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              TextWrapping="Wrap"
                              Grid.Column="1" />
            </Grid>
          </ControlTemplate>
        </Setter>
    </Style>
    
    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#cacaca"/>
    </Style>
    
    <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="#cacaca"/>
    </Style>
    
    <Style Selector="CheckBox:unchecked /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#969696"/>
    </Style>
    
    <Style Selector="CheckBox:pointerover /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#cacaca"/>
    </Style>
    
    
    
</Styles>
