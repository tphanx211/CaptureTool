<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Background="Black" Padding="20" Width="320" Height="530">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                <Image Source="/Assets/CaptureToolLogo.png"
                       Width="70" Height="70"
                       HorizontalAlignment="Center" />
                
                <TextBlock Text="Tony’s Demo"
                           FontFamily="{DynamicResource InterBold}"
                           FontSize="16"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />

                <Button Classes="secondary">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <Label Classes="icon" Content="&#xE326;" FontFamily="{DynamicResource Phosphor}" Margin="0 3  0 0"/>
                        <TextBlock Text="Voice transcription" FontFamily="{DynamicResource InterBold}" Margin="0 4  0 0"/>
                        <ToggleSwitch IsChecked="True" Margin="0 -5  0 0"/>
                    </StackPanel>
                </Button>

                <Button Classes="primary" >
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="2">
                        <Label Classes="icon" Content="&#xE3EE;" FontFamily="{DynamicResource PhosphorFill}" />
                        <TextBlock Text="Start Capture" FontFamily="{DynamicResource InterBold}" Margin="0 2  0 0"/>
                    </StackPanel>
                </Button>

                <Button Classes="secondary" Content="Sign Out" FontFamily="{DynamicResource InterBold}"/>
            </StackPanel>
        </Border>
    </Design.PreviewWith>
    
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{DynamicResource Inter}"/>
        <Setter Property="Background" Value="#AA2C2C2C" /> <!-- semi-transparent gray -->
        <Setter Property="TransparencyLevelHint" Value="AcrylicBlur" />
        <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
    </Style>
    
    <Style Selector="MenuItem.button">
        <Setter Property="FontFamily" Value="{DynamicResource Phosphor}" />
    </Style>
    
    <Style Selector="Label.icon">
        <Setter Property="FontFamily" Value="{DynamicResource Phosphor}"></Setter>
        <Setter Property="Margin" Value="0 1 0 0 "></Setter>
    </Style>
    
    <Style Selector="TextBlock.menu">
        <Setter Property="Foreground" Value="#99FFFFFF"/>
        <Setter Property="FontFamily" Value="{DynamicResource Phosphor}"/>
    </Style>
    <Style Selector="TextBlock.menu:pointerover">
        <Setter Property="Foreground" Value="#FFFFFFFF"/>
        <Setter Property="FontFamily" Value="{DynamicResource Phosphor}"/>
    </Style>
    
    <StyleInclude Source="Controls/ButtonStyles.axaml"/>
    <StyleInclude Source="Controls/ToggleSwitchStyles.axaml"/>
    <StyleInclude Source="Controls/CheckBoxStyles.axaml"/>
    <StyleInclude Source="Controls/ListBoxStyles.axaml"/>
</Styles>
